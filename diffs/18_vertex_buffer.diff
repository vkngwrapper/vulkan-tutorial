+func (app *HelloTriangleApplication) createVertexBuffer() error {
+	var err error
+	bufferSize := binary.Size(vertices)
+	app.vertexBuffer, _, err = app.deviceDriver.CreateBuffer(nil, core1_0.BufferCreateInfo{
+		Size:        bufferSize,
+		Usage:       core1_0.BufferUsageVertexBuffer,
+		SharingMode: core1_0.SharingModeExclusive,
+	})
+	if err != nil {
+		return err
+	}
+
+	memRequirements := app.deviceDriver.GetBufferMemoryRequirements(app.vertexBuffer)
+	memoryTypeIndex, err := app.findMemoryType(memRequirements.MemoryTypeBits, core1_0.MemoryPropertyHostVisible|core1_0.MemoryPropertyHostCoherent)
+	if err != nil {
+		return err
+	}
+
+	app.vertexBufferMemory, _, err = app.deviceDriver.AllocateMemory(nil, core1_0.MemoryAllocateInfo{
+		AllocationSize:  memRequirements.Size,
+		MemoryTypeIndex: memoryTypeIndex,
+	})
+	if err != nil {
+		return err
+	}
+
+	_, err = app.deviceDriver.BindBufferMemory(app.vertexBuffer, app.vertexBufferMemory, 0)
+	if err != nil {
+		return err
+	}
+
+	memory, _, err := app.deviceDriver.MapMemory(app.vertexBufferMemory, 0, bufferSize, 0)
+	if err != nil {
+		return err
+	}
+	defer app.deviceDriver.UnmapMemory(app.vertexBufferMemory)
+
+	dataBuffer := unsafe.Slice((*byte)(memory), bufferSize)
+
+	buf := &bytes.Buffer{}
+	err = binary.Write(buf, common.ByteOrder, vertices)
+	if err != nil {
+		return err
+	}
+
+	copy(dataBuffer, buf.Bytes())
+
+	return nil
+}
+
+func (app *HelloTriangleApplication) findMemoryType(typeFilter uint32, properties core1_0.MemoryPropertyFlags) (int, error) {
+	memProperties := app.instanceDriver.GetPhysicalDeviceMemoryProperties(app.physicalDevice)
+	for i, memoryType := range memProperties.MemoryTypes {
+		typeBit := uint32(1 << i)
+
+		if (typeFilter&typeBit) != 0 && (memoryType.PropertyFlags&properties) == properties {
+			return i, nil
+		}
+	}
+
+	return 0, errors.New("failed to find any suitable memory type!")
+}
